  "license": "MIT",
  "keywords": [
    "jianpu",
    "numbered-notation",
    "music-notation",
    "sheet-music",
    "musicxml",
    "jpwabc",
    "123-notation",
    "visual-editing",
    "fanqie-jianpu",
    "jianpu-text",
    "omr",
    "staff-omr",
    "abc-notation",
    "pptx",
    "tauri",
    "svg"
  ],
  "scripts": {
