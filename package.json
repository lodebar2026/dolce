{
  "name": "dolce",
  "private": true,
  "version": "0.8.5",
  "type": "module",
  "description": "开源简谱编辑与排版器：123 简谱格式、谱面可视化编辑、.jpwabc 与文本谱（番茄简谱 / 诗歌本动态谱）、ABC、MusicXML；本地识谱（简谱图片/PDF、五线谱 PDF）、简谱·五线谱混排、试听与 PPTX/MIDI/MusicXML/PDF/PNG 导出 · An open-source jianpu (numbered musical notation) editor & typesetter.",
  "homepage": "https://lodebar2026.github.io/dolce/",
  "repository": {
    "type": "git",
    "url": "https://github.com/lodebar2026/dolce.git"
  },
  "author": "lodebar2026",
  "license": "MIT",
  "keywords": [
    "jianpu",
    "numbered-notation",
    "music-notation",
    "sheet-music",
    "musicxml",
    "jpwabc",
    "123-notation",
    "visual-editing",
    "fanqie-jianpu",
    "jianpu-text",
    "omr",
    "staff-omr",
    "abc-notation",
    "pptx",
    "tauri",
    "svg"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "release": "bash scripts/release.sh",
    "build:cli": "vite build --config vite.cli.config.ts",
    "pack:omr": "node scripts/pack-omr.mjs",
    "test": "node -e \"require('fs').existsSync('../dev/vitest.config.ts')||(console.error('识别回归用例在同级的本地私有仓库 ../dev（语料有版权，不随公开仓库分发），没有它就没有可跑的测试'),process.exit(1))\" && vitest run --config ../dev/vitest.config.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "codemirror": "^6.0.2",
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "onnxruntime-web": "^1.30.0",
    "opencc-js": "^1.4.2",
    "opentype.js": "^2.0.0",
    "pdfjs-dist": "^6.4.299",
    "sharp": "^0.35.5",
    "smplr": "^1.1.0"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@tauri-apps/cli": "^2.12.3",
    "@types/opentype.js": "^1.3.10",
    "onnxruntime-node": "^1.30.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.64.1",
    "typescript": "~5.6.2",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  }
}
